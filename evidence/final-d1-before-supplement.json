        "name": "_cf_KV",
        "type": "table",
        "sql": "CREATE TABLE _cf_KV (\n        key TEXT PRIMARY KEY,\n        value BLOB\n      ) WITHOUT ROWID"
      },
      {
        "name": "d1_migrations",
        "type": "table",
        "sql": "CREATE TABLE \"d1_migrations\"(\n\t\tid         INTEGER PRIMARY KEY AUTOINCREMENT,\n\t\tname       TEXT UNIQUE,\n\t\tapplied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL\n)"
      },
      {
        "name": "execution_closed_immutable",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_closed_immutable BEFORE UPDATE ON execution_logs\nWHEN OLD.ended_at IS NOT NULL\nBEGIN SELECT RAISE(ABORT, 'closed execution is immutable'); END"
      },
      {
        "name": "execution_complete_task",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_complete_task AFTER UPDATE OF ended_at ON execution_logs\nWHEN OLD.ended_at IS NULL AND NEW.ended_at IS NOT NULL\nBEGIN\n  UPDATE tasks SET status = 'completed', completed_at = NEW.ended_at, updated_at = NEW.ended_at\n  WHERE id = NEW.task_id;\nEND"
      },
      {
        "name": "execution_duration_guard",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_duration_guard BEFORE UPDATE ON execution_logs\nWHEN OLD.ended_at IS NULL AND NEW.ended_at IS NOT NULL AND (\n  typeof(NEW.actual_seconds) <> 'integer' OR\n  NEW.actual_seconds <> (\n    (CAST(strftime('%s', NEW.ended_at) AS INTEGER) * 1000 + CAST(substr(NEW.ended_at, 21, 3) AS INTEGER)) -\n    (CAST(strftime('%s', NEW.started_at) AS INTEGER) * 1000 + CAST(substr(NEW.started_at, 21, 3) AS INTEGER))\n  ) / 1000\n)\nBEGIN SELECT RAISE(ABORT, 'execution duration does not match timestamps'); END"
      },
      {
        "name": "execution_identity_immutable",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_identity_immutable BEFORE UPDATE ON execution_logs\nWHEN NEW.id IS NOT OLD.id OR NEW.task_id IS NOT OLD.task_id\n  OR NEW.started_at IS NOT OLD.started_at OR NEW.start_request_id IS NOT OLD.start_request_id\n  OR NEW.estimated_seconds_at_start IS NOT OLD.estimated_seconds_at_start\nBEGIN SELECT RAISE(ABORT, 'execution identity is immutable'); END"
      },
      {
        "name": "execution_logs",
        "type": "table",
        "sql": "CREATE TABLE execution_logs (\n  id TEXT PRIMARY KEY NOT NULL,\n  task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE RESTRICT,\n  started_at TEXT NOT NULL,\n  ended_at TEXT,\n  actual_seconds INTEGER CHECK (actual_seconds >= 0),\n  estimated_seconds_at_start INTEGER NOT NULL CHECK (estimated_seconds_at_start BETWEEN 0 AND 31536000),\n  start_request_id TEXT NOT NULL UNIQUE,\n  finish_request_id TEXT UNIQUE,\n  CHECK ((ended_at IS NULL AND actual_seconds IS NULL AND finish_request_id IS NULL)\n    OR (ended_at IS NOT NULL AND actual_seconds IS NOT NULL AND finish_request_id IS NOT NULL AND ended_at >= started_at))\n)"
      },
      {
        "name": "execution_one_active_per_task",
        "type": "index",
        "sql": "CREATE UNIQUE INDEX execution_one_active_per_task ON execution_logs(task_id) WHERE ended_at IS NULL"
      },
      {
        "name": "execution_preserve_delete",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_preserve_delete BEFORE DELETE ON execution_logs\nBEGIN SELECT RAISE(ABORT, 'execution records must be preserved'); END"
      },
      {
        "name": "execution_start_guard",
        "type": "trigger",
        "sql": "CREATE TRIGGER execution_start_guard BEFORE INSERT ON execution_logs\nWHEN NOT EXISTS (SELECT 1 FROM tasks WHERE id = NEW.task_id AND status = 'in_progress' AND deleted_at IS NULL)\nBEGIN SELECT RAISE(ABORT, 'task is not available for execution'); END"
      },
      {
        "name": "plan_versions",
        "type": "table",
        "sql": "CREATE TABLE plan_versions (\n  plan_id TEXT NOT NULL REFERENCES plans(id) ON DELETE RESTRICT,\n  version INTEGER NOT NULL CHECK (version >= 1),\n  title TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 200),\n  period_start TEXT NOT NULL,\n  period_end TEXT NOT NULL CHECK (period_end >= period_start),\n  success_criteria TEXT NOT NULL CHECK (length(trim(success_criteria)) BETWEEN 1 AND 4000),\n  estimated_seconds INTEGER NOT NULL CHECK (estimated_seconds BETWEEN 0 AND 31536000),\n  recorded_at TEXT NOT NULL,\n  PRIMARY KEY (plan_id, version)\n)"
      },
      {
        "name": "plan_versions_immutable_delete",
        "type": "trigger",
        "sql": "CREATE TRIGGER plan_versions_immutable_delete BEFORE DELETE ON plan_versions\nBEGIN SELECT RAISE(ABORT, 'plan versions are immutable'); END"
      },
      {
        "name": "plan_versions_immutable_update",
        "type": "trigger",
        "sql": "CREATE TRIGGER plan_versions_immutable_update BEFORE UPDATE ON plan_versions\nBEGIN SELECT RAISE(ABORT, 'plan versions are immutable'); END"
      },
      {
        "name": "plans",
        "type": "table",
        "sql": "CREATE TABLE plans (\n  id TEXT PRIMARY KEY NOT NULL,\n  current_version INTEGER NOT NULL CHECK (current_version >= 1),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL\n)"
      },
      {
        "name": "sqlite_sequence",
        "type": "table",
        "sql": "CREATE TABLE sqlite_sequence(name,seq)"
      },
      {
        "name": "tags",
        "type": "table",
        "sql": "CREATE TABLE tags (\n  id TEXT PRIMARY KEY NOT NULL,\n  name TEXT NOT NULL UNIQUE CHECK (length(trim(name)) BETWEEN 1 AND 40)\n)"
      },
      {
        "name": "task_complete_guard",
        "type": "trigger",
        "sql": "CREATE TRIGGER task_complete_guard BEFORE UPDATE OF status ON tasks\nWHEN NEW.status = 'completed' AND EXISTS (SELECT 1 FROM execution_logs WHERE task_id = NEW.id AND ended_at IS NULL)\nBEGIN SELECT RAISE(ABORT, 'task still has an active execution'); END"
      },
      {
        "name": "task_copy_source_guard",
        "type": "trigger",
        "sql": "CREATE TRIGGER task_copy_source_guard BEFORE INSERT ON tasks\nWHEN NEW.copied_from_task_id IS NOT NULL AND NOT EXISTS (\n  SELECT 1 FROM tasks WHERE id = NEW.copied_from_task_id AND status = 'completed' AND deleted_at IS NULL\n)\nBEGIN SELECT RAISE(ABORT, 'copy source is no longer completed'); END"
      },
      {
        "name": "task_delete_active_guard",
        "type": "trigger",
        "sql": "CREATE TRIGGER task_delete_active_guard BEFORE UPDATE OF deleted_at ON tasks\nWHEN NEW.deleted_at IS NOT NULL AND EXISTS (SELECT 1 FROM execution_logs WHERE task_id = NEW.id AND ended_at IS NULL)\nBEGIN SELECT RAISE(ABORT, 'task still has an active execution'); END"
      },
      {
        "name": "task_tags",
        "type": "table",
        "sql": "CREATE TABLE task_tags (\n  task_id TEXT NOT NULL REFERENCES tasks(id) ON DELETE RESTRICT,\n  tag_id TEXT NOT NULL REFERENCES tags(id) ON DELETE RESTRICT,\n  PRIMARY KEY (task_id, tag_id)\n)"
      },
      {
        "name": "task_tags_tag",
        "type": "index",
        "sql": "CREATE INDEX task_tags_tag ON task_tags(tag_id, task_id)"
      },
      {
        "name": "tasks",
        "type": "table",
        "sql": "CREATE TABLE tasks (\n  id TEXT PRIMARY KEY NOT NULL,\n  plan_id TEXT NOT NULL REFERENCES plans(id) ON DELETE RESTRICT,\n  content TEXT NOT NULL CHECK (length(trim(content)) BETWEEN 1 AND 2000),\n  priority TEXT NOT NULL CHECK (priority IN ('high', 'medium', 'low')),\n  due_date TEXT,\n  estimated_seconds INTEGER NOT NULL CHECK (estimated_seconds BETWEEN 0 AND 31536000),\n  status TEXT NOT NULL DEFAULT 'in_progress' CHECK (status IN ('in_progress', 'completed')),\n  completed_at TEXT,\n  copied_from_task_id TEXT REFERENCES tasks(id) ON DELETE RESTRICT,\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  deleted_at TEXT,\n  CHECK ((status = 'completed' AND completed_at IS NOT NULL) OR (status = 'in_progress' AND completed_at IS NULL))\n)"
      },
