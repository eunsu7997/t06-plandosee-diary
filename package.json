{
  "name": "aleph-t06-pds-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/local.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "cf:whoami": "wrangler whoami",
    "cf:db:create": "wrangler d1 create aleph-t06-pds-diary-db --binding DB --update-config",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:deploy:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-check",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
